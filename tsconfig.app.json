{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode (chuẩn TS mới) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* React */
    "jsx": "react-jsx",

    /* Alias @ */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Types */
    "types": ["vite/client"],

    /* Custom types */
    "typeRoots": ["./node_modules/@types", "./src/shared/types"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "scripts",
    "src/modules/billOfMaterial/**",
    "src/modules/commissionDebtAdjustment/**",
    "src/modules/commissionDebtReport/**",
    "src/modules/deviceWhitelist/**",
    "src/modules/employee/**",
    "src/modules/excel/**",
    "src/modules/gateLog/**",
    "src/modules/inventoryConversion/**",
    "src/modules/invoice/**",
    "src/modules/jobPosititon/**",
    "src/modules/operationLog/**",
    "src/modules/organization/**",
    "src/modules/partnerContact/**",
    "src/modules/partnerDebtAdjustment/**",
    "src/modules/partnerDebtOffset/**",
    "src/modules/partnerDebtReport/**",
    "src/modules/paymentRequest/**",
    "src/modules/paymentTerm/**",
    "src/modules/pos/**",
    "src/modules/production/**",
    "src/modules/purchase/**",
    "src/modules/purchaseLine/**",
    "src/modules/purchaseQuotation/**",
    "src/modules/purchaseRequisition/**",
    "src/modules/quotation/**",
    "src/modules/quotationLine/**",
    "src/modules/quotationRequest/**",
    "src/modules/referralCode/**",
    "src/modules/service/**",
    "src/modules/shippingPlan/**",
    "src/modules/stockDocument/**",
    "src/modules/stockDocumentLine/**",
    "src/modules/warehouse/**",
    "src/modules/warehouseTransfer/**",
    "src/shared/pages/Private/DebtManagerment.tsx"
    ,"src/shared/pages/Public/QuotationRequestPage.tsx"
    ,"src/shared/pages/Public/QuotationRequestDetailPage.tsx"
    ,"src/shared/pages/Public/SupplierQuotationPage.tsx"
    ,"src/shared/pages/Public/SupplierQuotationDetailPage.tsx"
    ,"src/shared/utils/html/employee.ts"
    ,"src/shared/components/ExcelTaskPanel.tsx"
    ,"src/shared/hooks/useExcelReload.ts"
    ,"src/shared/stores/excel.slice.ts"
  ]
}
